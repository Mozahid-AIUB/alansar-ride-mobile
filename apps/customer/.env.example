# Copy to .env. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
EXPO_PUBLIC_API_URL=https://api.alansartaxi.com
EXPO_PUBLIC_SOCKET_URL=https://api.alansartaxi.com

# Mapbox public token (pk.…), for the Mapbox map option and the browser map.
# Without it the app shows OpenStreetMap tiles, which are for development only.
EXPO_PUBLIC_MAPBOX_TOKEN=
EXPO_PUBLIC_MAPBOX_STYLE=mapbox/streets-v12
